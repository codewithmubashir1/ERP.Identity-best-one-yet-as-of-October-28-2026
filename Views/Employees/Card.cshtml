        /* =========================================================
           PNG
           ========================================================= */

        function downloadCardPng() {

            const cards = [

                document.getElementById(
                    'employeeCardFront'
                ),

                document.getElementById(
                    'employeeCardBack'
                )

            ];


            const canvas =
                document.createElement('canvas');


            const ctx =
                canvas.getContext('2d');


            const pageWidth = 850;
            const pageHeight = 1080;


            canvas.width =
                pageWidth * 2;


            canvas.height =
                pageHeight * 2;


            ctx.scale(2, 2);


            ctx.fillStyle =
                '#f7f9fa';


            ctx.fillRect(
                0,
                0,
                pageWidth,
                pageHeight
            );


            const loadCard =
                (card, yPos) => {

                    return html2canvas(
                        card,
                        {
                            scale: 2,

                            backgroundColor:
                                '#ffffff',

                            useCORS:
                                true
                        }
                    )
                    .then(rendered => {

                        ctx.drawImage(
                            rendered,

                            0,
                            yPos,

                            rendered.width / 2,
                            rendered.height / 2
                        );

                    });

                };


            Promise.all([

                loadCard(
                    cards[0],
                    0
                ),

                loadCard(
                    cards[1],
                    550
                )

            ])
            .then(() => {

                const link =
                    document.createElement('a');


                link.download =
                    '@(Model.EmployeeCode)-employee-card.png';


                link.href =
                    canvas.toDataURL('image/png');

                document.body.appendChild(link);

                link.click();

                document.body.removeChild(link);

            });

        }

