                URL.createObjectURL(blob);


            const link =
                document.createElement('a');


            link.href = url;

            link.download =
                '@(Model.EmployeeCode)-employee-card.svg';


            document.body.appendChild(link);

            link.click();

            document.body.removeChild(link);


            setTimeout(() => {

                URL.revokeObjectURL(url);

            }, 100);

